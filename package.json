{
  "name": "",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "bun": ">=1.3.6"
  },
  "scripts": {
    "build:resume": "bun run scripts/build-resume.ts",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "biome check . && bun run lint:whitespace && bun run lint:prose",
    "lint:fix": "biome check --write . && bun run lint:whitespace:fix && bun run lint:prose:fix",
    "lint:whitespace": "tsx scripts/lint-whitespace.ts",
    "lint:whitespace:fix": "tsx scripts/lint-whitespace.ts --fix",
    "lint:prose": "tsx scripts/lint-prose.ts",
    "lint:prose:fix": "tsx scripts/lint-prose.ts --fix",
    "format": "biome format --write .",
    "test": "env -u NO_COLOR vitest run",
    "test:unit": "env -u NO_COLOR vitest run",
    "test:unit:watch": "env -u NO_COLOR vitest",
    "test:e2e": "env -u NO_COLOR PLAYWRIGHT_BROWSERS_PATH=0 playwright test",
    "test:e2e:ui": "env -u NO_COLOR PLAYWRIGHT_BROWSERS_PATH=0 playwright test --ui",
    "new": "tsx scripts/new-post.ts",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.13",
    "@astrojs/rss": "^4.0.15",
    "@astrojs/sitemap": "^3.7.0",
    "@playform/inline": "^0.1.2",
    "astro": "5.16.11",
    "astro-og-canvas": "^0.10.0",
    "canvaskit-wasm": "^0.40.0",
    "feed": "^5.2.0",
    "katex": "^0.16.27",
    "markdown-it": "^14.1.0",
    "mdast-util-to-string": "^4.0.0",
    "node-html-parser": "^7.0.2",
    "reading-time": "^1.5.0",
    "rehype-katex": "^7.0.1",
    "remark-directive": "^4.0.0",
    "remark-math": "^6.0.0",
    "sanitize-html": "^2.17.0",
    "sharp": "^0.34.5",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@biomejs/biome": "^2.3.11",
    "@expressive-code/plugin-line-numbers": "^0.41.6",
    "@playwright/test": "^1.58.2",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.2.3",
    "@types/sanitize-html": "^2.16.0",
    "astro-expressive-code": "^0.41.6",
    "marked": "^17.0.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
