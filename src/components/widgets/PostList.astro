---
import FormattedDate from '@/components/widgets/FormattedDate.astro';
import { themeConfig } from '@/config';
import type { PostListProps } from '@/types';

declare const Astro: any;
const { posts, lang } = Astro.props as PostListProps;

function getQuarter(date: Date) {
  const monthIndex = date.getMonth(); // 0-11
  return Math.floor(monthIndex / 3) + 1; // 1-4
}

function quarterLabel(date: Date) {
  const q = getQuarter(date);
  return `Q${q} ${date.getFullYear()}`;
}

type Group = {
  key: string;
  label: string;
  posts: typeof posts;
};

const groups: Group[] = [];
for (const post of posts) {
  const label = quarterLabel(post.data.pubDate);
  let g = groups[groups.length - 1];
  if (!g || g.key !== label) {
    g = { key: label, label, posts: [] as unknown as typeof posts };
    groups.push(g);
  }
  g.posts.push(post);
}
---

<div class="post-search">
  <label class="sr-only" for="post-search-input">Search posts</label>
  <input
    id="post-search-input"
    type="search"
    placeholder="Search articles…"
    autocomplete="off"
    spellcheck="false"
    tabindex="3"
  />
  <p class="post-search-meta" id="post-search-meta" aria-live="polite"></p>
</div>

<div class="post-groups">
  {groups.map((group) => (
    <details class="post-group" data-post-group>
      <summary class="post-group-title">{group.label}</summary>
      <div class="post-group-body" data-post-group-body>
        <ul>
          {group.posts.map((post) => (
            <li data-post-item>
              <a
                href={`/${lang}/${post.id}/`}
                data-post-title={post.data.title}
                data-post-slug={post.id}
              >
                <div class={`post-item ${!themeConfig.date.dateOnRight ? 'date-left' : ''}`}>
                  {!themeConfig.date.dateOnRight && (
                    <p class="date font-features">
                      <FormattedDate date={post.data.pubDate} context="list" />
                    </p>
                  )}
                  <p class="title">{post.data.title}</p>
                  {themeConfig.date.dateOnRight && (
                    <div class={themeConfig.general.postListDottedDivider ? 'dotted-divider' : 'divider'} />
                  )}
                  {themeConfig.date.dateOnRight && (
                    <p class="date font-features">
                      <FormattedDate date={post.data.pubDate} context="list" />
                    </p>
                  )}
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </details>
  ))}
</div>

<script is:inline>
  const input = document.getElementById('post-search-input')
  const meta = document.getElementById('post-search-meta')
  const root = input?.closest('main')

  if (input instanceof HTMLInputElement && meta instanceof HTMLParagraphElement && root) {
    const groups = Array.from(root.querySelectorAll('[data-post-group]'))
    const items = Array.from(root.querySelectorAll('[data-post-item]'))
    const links = items.map((li) => li.querySelector('a'))

    const normalize = (s) => (s || '').toLowerCase().trim()

    const apply = () => {
      const q = normalize(input.value)
      let shown = 0

      for (let i = 0; i < items.length; i++) {
        const a = links[i]
        if (q) {
          const title = normalize(a?.getAttribute('data-post-title'))
          const slug = normalize(a?.getAttribute('data-post-slug'))
          const match = title.includes(q) || slug.includes(q)
          items[i].style.display = match ? '' : 'none'
          if (match) shown++
        } else {
          items[i].style.display = ''
          shown++
        }
      }

      // Hide group headers when they have no visible items (mostly for search)
      for (const g of groups) {
        const groupItems = Array.from(g.querySelectorAll('[data-post-item]'))
        const anyVisible = groupItems.some((el) =>
          el instanceof HTMLElement ? el.style.display !== 'none' : true,
        )
        g.style.display = anyVisible ? '' : 'none'

        if (q) {
          // While searching, only expand groups that actually have visible matches.
          if (anyVisible) {
            if (g instanceof HTMLDetailsElement) {
              g.open = true
              g.dataset.autoOpened = 'true'
            }
          } else if (g instanceof HTMLDetailsElement) {
            g.open = false
            delete g.dataset.autoOpened
          }
        } else if (g instanceof HTMLDetailsElement && g.dataset.autoOpened === 'true') {
          // If we auto-opened groups for search, collapse them again when query is cleared.
          g.open = false
          delete g.dataset.autoOpened
        }
      }

      // Show count only when searching
      meta.textContent = q ? `${shown} of ${items.length} articles` : ''
    }

    input.addEventListener('input', apply)

    apply()
  }
</script>

<style>
  .post-search {
    margin: 1rem 0 2rem 0;
  }

  .post-search input {
    width: 100%;
    font-family: var(--sans);
    font-size: var(--font-size-m);
    color: var(--text-primary);
    background: var(--code-bg);
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    padding: 0.65rem 0.75rem;
    /* Keep focus styling animatable (outline-color can fade in/out). */
    outline: 1.5px dashed transparent;
    outline-offset: 2px;
    transition:
      outline-color 160ms ease-out,
      border-color 160ms ease-out;
  }

  .post-search input::placeholder {
    color: var(--text-tertiary);
  }

  @media (hover: hover) and (pointer: fine) {
    /* Hover should gently preview the focus affordance. */
    .post-search input:hover {
      outline-color: color-mix(in srgb, var(--text-tertiary), transparent 55%);
      border-color: color-mix(in srgb, var(--border), var(--text-tertiary) 35%);
    }
  }

  .post-search input:focus-visible {
    outline-color: var(--text-tertiary);
    border-color: var(--text-tertiary);
  }

  .post-search-meta {
    margin: 0.5rem 0 0 0;
    font-size: var(--font-size-s);
    color: var(--text-secondary);
    opacity: 0.85;
  }

  .post-group-title {
    margin: 0;
    font-size: var(--font-size-l);
    font-weight: var(--font-weight-bold);
    color: var(--text-primary);
    letter-spacing: var(--spacing-m);
    text-transform: uppercase;
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .post-group-body {
    overflow: hidden;
    max-height: 0;
    transition: max-height 180ms ease;
  }

  details.post-group[open] > .post-group-body {
    /* Large enough to fit typical group sizes; avoids JS height-sync issues that broke tabbing. */
    max-height: 2000px;
  }

  .post-group:first-child .post-group-title {
    margin-top: 0.25rem;
  }

  /* Hide default disclosure triangle marker */
  .post-group-title::-webkit-details-marker {
    display: none;
  }

  /* Custom disclosure arrow on the right */
  .post-group-title::after {
    content: '▸';
    color: var(--text-secondary);
    font-size: 1.5em;
    letter-spacing: 0;
    flex: 0 0 auto;
  }

  details.post-group[open] > .post-group-title::after {
    content: '▾';
  }

  /* Slightly dim collapsed group headings */
  details.post-group:not([open]) > .post-group-title {
    color: var(--text-secondary);
  }

  /* Keyboard focus should match hover (green) */
  details.post-group > .post-group-title:focus-visible {
    color: #a6e3a1;
    outline: none;
  }

  details.post-group > .post-group-title:focus-visible::after {
    color: #a6e3a1;
  }

  @media (hover: hover) and (pointer: fine) {
    /* Ensure hover wins even when collapsed rules apply */
    details.post-group > .post-group-title:hover {
      color: #a6e3a1;
    }

    details.post-group > .post-group-title:hover::after {
      color: #a6e3a1;
    }
  }

  ul {
    padding: 0;
    margin: 0;
    list-style-type: none;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  a {
    color: var(--text-primary);
    display: block;
    text-decoration: none;
    transition: opacity 0.15s ease-out;
  }

  /* Keyboard focus should feel like hover: dim the list, spotlight the active row */
  ul:focus-within a {
    opacity: 0.4;
  }

  /* Must be more specific than `ul:focus-within a` so the focused item stays bright */
  ul:focus-within a:focus-visible {
    opacity: 1;
  }

  a:focus-visible {
    opacity: 1;
    outline: none;
    color: #a6e3a1;
  }

  a:focus-visible .date {
    color: #a6e3a1;
    opacity: 0.9;
  }

  a:focus-visible .divider {
    background-color: #a6e3a1;
    opacity: 0.65;
  }

  a:focus-visible .dotted-divider {
    color: #a6e3a1;
    opacity: 0.65;
  }

  /* (removed old focus styling; green focus now handled above) */

  /* Visited (read) posts: slightly muted compared to unread.
     Keep hover/focus styles in control. */
  a:visited:not(:hover):not(:focus-visible) {
    color: var(--text-secondary);
  }

  @media (hover: hover) and (pointer: fine) {
    ul:hover a {
      opacity: 0.4;
    }

    ul:hover a:hover {
      opacity: 1;
    }

    ul:hover a:focus-visible {
      opacity: 1;
    }

    /* Post row hover matches section hover color */
    ul:hover a:hover,
    ul:hover a:focus-visible {
      color: #a6e3a1;
    }

    ul:hover a:hover .date,
    ul:hover a:focus-visible .date {
      color: #a6e3a1;
      opacity: 0.9;
    }

    ul:hover a:hover .divider,
    ul:hover a:focus-visible .divider {
      background-color: #a6e3a1;
      opacity: 0.65;
    }

    ul:hover a:hover .dotted-divider,
    ul:hover a:focus-visible .dotted-divider {
      color: #a6e3a1;
      opacity: 0.65;
    }

    /* (removed old hover styling; green hover now handled above) */
  }

  .post-item {
    height: 2.75rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
  }

  .post-item.date-left {
    justify-content: flex-start;
  }

  .post-item.date-left .title {
    flex: 1 1 auto;
    min-width: 0;
  }

  .post-item.date-left .date {
    margin-right: 0.75rem;
  }

  .title {
    margin: 0;
    flex-shrink: 1;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .date {
    margin: 0;
    color: var(--text-secondary);
    opacity: 0.75;
    letter-spacing: var(--spacing-s);
    flex-shrink: 0;
    white-space: nowrap;
  }

  .divider {
    flex: 1 1 auto;
    min-width: 3rem;
    margin: 0 0.25rem;
    height: 0.5px;
    background-color: var(--border);
  }

  .dotted-divider {
    flex: 1 1 3rem;
    min-width: 3rem;
    max-width: 100%;
    text-align: end;
    letter-spacing: 5px;
    height: 1.675rem;
    overflow: hidden;
    color: var(--text-tertiary);
    opacity: 0.75;
  }

  .dotted-divider::after {
    content: '·····························································································································································';
    pointer-events: none;
  }
</style>
