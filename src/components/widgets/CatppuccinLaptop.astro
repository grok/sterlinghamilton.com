<style>
  .catppuccin-hero {
    display: block;
    margin-block: 1.25rem 0.5rem;
    margin-inline: auto;
    max-width: 820px;
    text-decoration: none;
  }

  .catppuccin-hero svg {
    width: 100%;
    height: auto;
    display: block;

    /*
      Match Catppuccin’s own site behavior:
      - Light mode uses Latte tokens
      - Dark mode uses Mocha tokens
      - --inverted-text flips between var(--base) (Latte) and var(--crust) (Mocha)
    */

    /* Latte (light) */
    --base: #eff1f5;
    --mantle: #e6e9ef;
    --crust: #dce0e8;
    --text: #4c4f69;
    --subtext0: #6c6f85;
    --overlay0: #9ca0b0;
    --peach: #fe640b;
    --red: #d20f39;
    --yellow: #df8e1d;
    --blue: #1e66f5;
    --green: #40a02b;
    --inverted-text: var(--base);

    /* Original Catppuccin accent stops (purple) */
    --mauve: #8839ef;
    --pink: #ea76cb;

    /* Squares under laptop/coffee (light mode): black gradient */
    --square-green-start: color-mix(in srgb, #000, var(--base) 18%);
    --square-green-end: #000;

    /* Vars referenced by Catppuccin’s inline SVG CSS */
    --mocha-base: #1e1e2e;
    --latte-mauve: #8839ef;
    --blended-base-laptop: color-mix(in srgb, var(--mauve), var(--mocha-base) 40%);
    --shadow-color: color-mix(in srgb, var(--crust), var(--mauve) 6%);
  }

  /* Mocha (dark) */
  :global(html.dark) .catppuccin-hero svg {
    --base: #1e1e2e;
    --mantle: #181825;
    --crust: #11111b;
    --text: #cdd6f4;
    --subtext0: #a6adc8;
    --overlay0: #6c7086;
    --peach: #fab387;
    --red: #f38ba8;
    --yellow: #f9e2af;
    --blue: #89b4fa;
    --green: #a6e3a1;
    --inverted-text: var(--crust);

    /* Original Catppuccin accent stops (purple) */
    --mauve: #cba6f7;
    --pink: #f5c2e7;

    /* Green gradient for “glow squares” under laptop/coffee */
    /* Make the gradient *obviously* visible (dark mint → saturated green) */
    --square-green-start: color-mix(in srgb, var(--green), var(--base) 65%);
    --square-green-end: var(--green);
  }

  /* Catppuccin animation strategy: lift laptop/coffee on hover */
  .catppuccin-hero :global(#coffee),
  .catppuccin-hero :global(#laptop) {
    transform: translateY(0);
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 650ms cubic-bezier(0.2, 0, 0, 1);
    cursor: pointer;
  }

  @media (hover: hover) {
    .catppuccin-hero :global(#coffee:hover),
    .catppuccin-hero :global(#laptop:hover) {
      transform: translateY(-32px);
    }
  }

  
  /* Catppuccin SVG color hooks (ported from catppuccin.com, without scoped attributes) */
  .catppuccin-hero :global(#keyboard *),
  .catppuccin-hero :global(#trackpad) {
    fill: color-mix(in srgb, var(--mocha-base), var(--blue) 10%) !important;
    opacity: 0.8;
  }

  .catppuccin-hero :global(#base-highlight),
  .catppuccin-hero :global(#lid-shine) {
    fill: var(--crust) !important;
  }

  .catppuccin-hero :global(#window-background) {
    fill: var(--base) !important;
  }

  .catppuccin-hero :global(#window-edge) {
    fill: var(--mantle) !important;
  }

  .catppuccin-hero :global(#window-content) :global(.code-text) {
    fill: var(--text) !important;
  }

  .catppuccin-hero :global(#window-content) :global(.code-keyword) {
    fill: var(--green) !important;
  }

  .catppuccin-hero :global(#window-content) :global(.code-function) {
    fill: var(--red) !important;
  }

  .catppuccin-hero :global(#window-content) :global(.code-int) {
    fill: var(--blue) !important;
  }

  .catppuccin-hero :global(#window-decorations) :global(#min),
  .catppuccin-hero :global(#window-decorations) :global(#max) {
    fill: var(--subtext0) !important;
  }

  .catppuccin-hero :global(#window-decorations) :global(#close) {
    fill: var(--red) !important;
  }

  /* Cup icon (now a capybara) */
  .catppuccin-hero :global(#paw) {
    fill: var(--inverted-text) !important;
    opacity: 0.8;
  }

  .catppuccin-hero :global(#steam) {
    fill: color-mix(in srgb, var(--overlay0), var(--pink) 20%) !important;
    opacity: 0.5;
  }
  @media (prefers-reduced-motion: reduce) {
    .catppuccin-hero :global(#coffee),
    .catppuccin-hero :global(#laptop) {
      transition: none;
    }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
