---
import ThemeToggle from '@/components/ui/ThemeToggle.astro';
import LanguageToggle from '@/components/ui/LanguageToggle.astro';
import ContactIconLink from '@/components/ui/ContactIconLink.astro';
import { themeConfig } from '@/config';
import { getUiLabels } from '@/utils/i18n';

type Props = {
  lang?: string;
  /** Optional override for the wordmark title text (e.g. on the contact page). */
  title?: string;
  translations?: Array<{
    code: string;
    label: string;
    href: string;
    active: boolean;
    available: boolean;
  }>;
  /** Hide the big site title (useful on post pages). */
  showTitle?: boolean;
};

const { lang, title, translations, showTitle = true } = Astro.props as Props;
const langCandidate =
  (lang || themeConfig.site.defaultLocale).split('-')[0] ||
  themeConfig.site.defaultLocale;
const contactHref = `/${langCandidate}/contact/`;
const homeHref = `/${langCandidate}/`;
const ui = getUiLabels(langCandidate);
const wordmarkTitle = title || ui.homeTitle;
const isOnContactPage = /\/contact\/?$/.test(Astro.url.pathname);
const isOnHomePage = /^\/[a-z]{2}\/?$/.test(Astro.url.pathname) || Astro.url.pathname === '/';
---

<header data-show-title={showTitle}>
  <nav>
    {showTitle && (
      isOnHomePage
        ? <span class="site-title wordmark-title">{wordmarkTitle}</span>
        : <a href={homeHref} class="site-title wordmark-title wordmark">{wordmarkTitle}</a>
    )}
    <div class="controls icon-controls">
      <ContactIconLink
        href={contactHref}
        label={ui.contact}
        disabled={isOnContactPage}
        disabledLabel={ui.alreadyOnContactPage}
      />
      <ThemeToggle />
      <LanguageToggle lang={langCandidate} translations={translations} />
    </div>
  </nav>
</header>
<style>
  header {
    margin: 0;
  }
  nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .controls {
    display: flex;
    align-items: center;
  }

  header[data-show-title="false"] nav {
    justify-content: flex-end;
  }

  /* Typography for the title is shared globally via .wordmark-title */

</style>
