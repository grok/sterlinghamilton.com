<div class="toast-region" aria-live="polite" aria-atomic="true" data-toast-region>
  <!-- toasts injected here -->
</div>

<script is:inline>
  ;(function () {
    const REGION_SELECTOR = '[data-toast-region]'

    function getRegion() {
      const region = document.querySelector(REGION_SELECTOR)
      return region instanceof HTMLElement ? region : null
    }

    function escapeHtml(str) {
      return String(str)
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#039;')
    }

    function showToast(detail) {
      const region = getRegion()
      if (!region) return

      const message = typeof detail === 'string' ? detail : detail?.message
      if (!message) return

      const variant = (typeof detail === 'object' && detail?.variant) || 'info'
      const duration = (typeof detail === 'object' && detail?.duration) || 2400

      const toast = document.createElement('div')
      toast.className = `toast toast--${variant}`
      toast.setAttribute('role', 'status')
      toast.innerHTML = `
        <div class="toast__message">${escapeHtml(message)}</div>
        <button class="toast__close" type="button" aria-label="Dismiss notification" title="Dismiss">
          ×
        </button>
      `

      const close = toast.querySelector('.toast__close')
      close?.addEventListener('click', () => toast.remove())
      toast.addEventListener('click', () => toast.remove())

      region.appendChild(toast)

      // Auto-remove
      window.setTimeout(() => {
        toast.remove()
      }, duration)
    }

    // Public API
    window.toast = function (message, options) {
      window.dispatchEvent(
        new CustomEvent('toast', {
          detail: typeof options === 'object' ? { message, ...options } : { message },
        }),
      )
    }

    window.addEventListener('toast', (e) => showToast(e.detail))

    // Expressive Code's copy buttons (best-effort toast).
    document.addEventListener('click', (e) => {
      const target = e.target
      if (!(target instanceof Element)) return
      const btn = target.closest('.expressive-code .copy button')
      if (!btn) return
      window.toast?.('Copied code.', { variant: 'success' })
    })
  })()
</script>

<style is:global>
  .toast-region {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 1000;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: min(22rem, calc(100vw - 2rem));
    pointer-events: none;
  }

  .toast {
    pointer-events: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.65rem 0.75rem;
    border-radius: 0.75rem;
    border: 1px solid var(--surface1);
    background: color-mix(in srgb, var(--surface0) 85%, transparent);
    backdrop-filter: blur(18px);
    color: var(--text-primary);
    box-shadow: 0 14px 40px rgba(0, 0, 0, 0.18);
    font-family: var(--sans);
    font-size: var(--font-size-s);
    letter-spacing: var(--spacing-m);
    cursor: pointer;
    animation: toast-in 180ms ease-out both;
  }

  .toast__message {
    line-height: 1.3;
  }

  .toast__close {
    appearance: none;
    border: none;
    background: transparent;
    color: var(--text-tertiary);
    font-size: 1.1rem;
    line-height: 1;
    padding: 0.15rem 0.25rem;
    border-radius: 0.5rem;
    cursor: pointer;
  }

  .toast__close:hover,
  .toast__close:focus-visible {
    color: var(--text-primary);
    outline: none;
    background: color-mix(in srgb, var(--surface2) 45%, transparent);
  }

  .toast--success {
    border-color: color-mix(in srgb, var(--heading-anchor-default-color, var(--surface1)) 30%, var(--surface1));
  }

  .toast--error {
    border-color: color-mix(in srgb, #d20f39 45%, var(--surface1)); /* Latte red */
  }

  html.dark .toast--error {
    border-color: color-mix(in srgb, #f38ba8 45%, var(--surface1)); /* Mocha red */
  }

  @keyframes toast-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .toast {
      animation: none;
    }
  }
</style>
