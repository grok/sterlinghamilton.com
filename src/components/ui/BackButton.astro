---
import { getUiLabels, localeFromPathname } from '@/utils/i18n';

const locale = localeFromPathname(Astro.url.pathname);
const { index } = getUiLabels(locale);
---

<a href={`/${locale}/`} class="back-button" title={index} aria-label={index} data-positioned="false">
  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path
      d="M2.5 6.5H9.5C11.1569 6.5 12.5 7.84315 12.5 9.5V9.5C12.5 11.1569 11.1569 12.5 9.5 12.5H7.5M2.5 6.5L5.5 9.5M2.5 6.5L5.5 3.5"
      stroke="currentColor"
      stroke-width="1.25"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>
  {index}
</a>

<script is:inline>
  ;(function () {
    // Adjust back button position based on layout and screen size
    function adjustBackButtonPosition() {
      const button = document.querySelector('.back-button')
      if (!button) return

      // If not using centered layout, remove fixed positioning
      const centeredLayout = document.body?.dataset?.centered === 'true'
      if (!centeredLayout) {
        button.classList.remove('fixed-position')
        button.style.left = ''
        button.dataset.positioned = 'true'
        return
      }

      const rootFontSize = parseFloat(getComputedStyle(document.documentElement).fontSize) || 16
      const rem = (value) => value * rootFontSize

      // Use the canonical width set by BaseLayout (`max-width`) so we don't duplicate clamping logic.
      const bodyMaxWidthPx = parseFloat(getComputedStyle(document.body).maxWidth)
      const pageWidth = window.innerWidth
      const maxWidth = Number.isFinite(bodyMaxWidthPx) && bodyMaxWidthPx > 0 ? bodyMaxWidthPx : rem(25)
      const margin = (pageWidth - maxWidth) / 2

      const baseMinSpace = rem(11) // Base minimum space needed
      const hasTOC = Boolean(document.querySelector('.toc-container'))
      // If TOC is present, need additional space so the button doesn't collide with it.
      const minSpace = hasTOC ? baseMinSpace + rem(3.25) : baseMinSpace + rem(0.75)

      // Position button fixed on the left if there's enough space
      if (margin >= minSpace) {
        button.classList.add('fixed-position')
        const basePosition = margin - baseMinSpace
        // If TOC is present, move further left.
        // 40px for lining up to TOC lines.
        const leftPosition = hasTOC ? basePosition - 40 - rem(2.5) : basePosition
        button.style.left = `${leftPosition}px`
      } else {
        button.classList.remove('fixed-position')
        button.style.left = ''
      }

      button.dataset.positioned = 'true'
    }

    // Wait one frame so the rest of the layout (incl. TOC) is in the DOM.
    function scheduleAdjust() {
      requestAnimationFrame(adjustBackButtonPosition)
    }

    // Bind listeners once; Astro navigations can re-execute inline scripts.
    if (!window.__sterlingBackButtonBound) {
      window.__sterlingBackButtonBound = true
      document.addEventListener('astro:page-load', scheduleAdjust)
      document.addEventListener('DOMContentLoaded', scheduleAdjust)
      window.addEventListener('resize', scheduleAdjust)
    }

    scheduleAdjust()
  })()
</script>

<style>
  .back-button {
    width: 8rem;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-family: var(--serif);
    font-size: var(--font-size-m);
    font-style: italic;
    letter-spacing: 0;
    line-height: 1.75;
    color: var(--text-secondary);
    cursor: pointer;
    border: none;
    background-color: transparent;
    position: relative;
    margin-bottom: 2.5em;
    padding: 0;
    left: 0;
    transition: color 0.2s ease-out;
    text-decoration: none;
  }

  /* Prevent initial "jump" when JS switches to fixed positioning. */
  .back-button[data-positioned='false'] {
    visibility: hidden;
  }

  @media (max-width: 768px) {
    .back-button[data-positioned='false'] {
      visibility: visible;
    }
  }

  .back-button:hover {
    color: var(--text-primary);
  }

  @media (hover: none) and (pointer: coarse) {
    .back-button:hover {
      color: var(--text-secondary);
    }
  }

  .back-button svg {
    width: 0.8rem;
    height: 0.8rem;
    flex-shrink: 0;
  }

  .back-button.fixed-position {
    position: fixed;
    top: 6rem;
    margin-bottom: 0;
    padding-left: 0.75rem;
    z-index: 10;
  }
</style>
