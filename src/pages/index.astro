---
import { themeConfig } from '@/config';
---
<!-- Locale redirect: keep a stable root URL but send users to the default locale -->
<html lang={themeConfig.site.language}>
  <head>
    <link rel="canonical" href={`/${themeConfig.site.defaultLocale}/`} />
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <script
      is:inline
      define:vars={{
        defaultLocale: themeConfig.site.defaultLocale,
        localeCodes: themeConfig.site.locales.map((l) => l.code),
      }}
    >
      try {
        const preferred = localStorage.getItem('preferredLang')
        const next = preferred && localeCodes.includes(preferred) ? preferred : defaultLocale
        const url = new URL(window.location.href)
        url.pathname = `/${next}/`
        // preserve search/hash
        window.location.replace(url.toString())
      } catch {
        const url = new URL(window.location.href)
        url.pathname = `/${defaultLocale}/`
        window.location.replace(url.toString())
      }
    </script>
    <noscript>
      <p>
        Continue to{' '}
        <a href={`/${themeConfig.site.defaultLocale}/`}>/{themeConfig.site.defaultLocale}/</a>.
      </p>
    </noscript>
  </body>
</html>
