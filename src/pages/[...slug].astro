---
import { getCollection } from 'astro:content';
import { themeConfig } from '@/config';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts
    .filter((post) => !post.id.startsWith('_'))
    .map((post) => ({
      params: { slug: post.id },
    }));
}
---

<!-- Legacy URL redirect: /:slug/ -> /:lang/:slug/ -->
<html lang={themeConfig.site.language}>
  <head>
    <link rel="canonical" href={`/${themeConfig.site.defaultLocale}/${Astro.params.slug}/`} />
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <script is:inline define:vars={{ defaultLocale: themeConfig.site.defaultLocale, slug: Astro.params.slug }}>
      try {
        const url = new URL(window.location.href)
        url.pathname = `/${defaultLocale}/${slug}/`
        // preserve search/hash
        window.location.replace(url.toString())
      } catch {
        window.location.replace(`/${defaultLocale}/${slug}/`)
      }
    </script>
    <noscript>
      <p>
        Continue to{' '}
        <a href={`/${themeConfig.site.defaultLocale}/${Astro.params.slug}/`}>
          /{themeConfig.site.defaultLocale}/{Astro.params.slug}/
        </a>
        .
      </p>
    </noscript>
  </body>
</html>
