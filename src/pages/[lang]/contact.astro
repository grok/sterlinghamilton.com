---
import SocialGrid from '@/components/ui/SocialGrid.astro';
import IndexLayout from '@/layouts/IndexLayout.astro';
import { themeConfig } from '@/config';
import BackButton from '@/components/ui/BackButton.astro';

export async function getStaticPaths() {
  return themeConfig.site.locales.map((l) => ({ params: { lang: l.code } }));
}

const lang = Astro.params.lang || themeConfig.site.defaultLocale;
const locale = themeConfig.site.locales.find((l) => l.code === lang);
const htmlLang = locale?.langTag || themeConfig.site.language;

const strings =
  lang === 'es'
    ? {
        title: 'Cómo ponerse en contacto conmigo',
      }
    : {
        title: 'How to get in touch with me',
      };
---

<IndexLayout
  title={`${strings.title} - ${themeConfig.site.name}`}
  description={strings.title}
  lang={htmlLang}
  headerTitle={strings.title}
>
  <main class="contact">
    <h1 class="sr-only">{strings.title}</h1>
    <BackButton />
    <SocialGrid
      links={[
        {
          href: 'https://www.linkedin.com/in/sterlinghamilton/',
          label: 'LinkedIn',
          icon: 'linkedin',
        },
        {
          href: 'https://github.com/grok',
          label: 'GitHub',
          icon: 'github',
        },
        {
          href: 'https://www.instagram.com/sterhamke/',
          label: 'Instagram',
          icon: 'instagram',
        },
        {
          href: 'https://open.spotify.com/user/sterlinghamilton',
          label: 'Spotify',
          icon: 'spotify',
        },
        {
          href: 'https://sterlinghamilton.com/resume.pdf',
          label: 'Resume',
          icon: 'resume',
        },
      ]}
    />
  </main>
</IndexLayout>

<style>
  .contact {
    margin-top: 2rem;
  }
</style>
