---
import SocialGrid from '@/components/ui/SocialGrid.astro';
import IndexLayout from '@/layouts/IndexLayout.astro';
import { themeConfig } from '@/config';
import BackButton from '@/components/ui/BackButton.astro';
import { getUiLabels } from '@/utils/i18n';

export async function getStaticPaths() {
  return themeConfig.site.locales.map((l) => ({ params: { lang: l.code } }));
}

const lang = Astro.params.lang || themeConfig.site.defaultLocale;
const locale = themeConfig.site.locales.find((l) => l.code === lang);
const htmlLang = locale?.langTag || themeConfig.site.language;

const strings =
  lang === 'es'
    ? {
        title: 'Contacta conmigo',
        p1: 'Si, escríbeme. En serio, por favor.',
        p2: 'LinkedIn es el mejor lugar para casi todo - preguntas de ingeniería, conversaciones de carrera, cosas de IA, o simplemente para saludar. Respondo de verdad.',
        p3: 'GitHub funciona si es sobre código o algo que encontraste aquí. Instagram y Spotify son prueba de que tengo vida fuera del trabajo. Los mensajes directos por ahí son otra historia.',
      }
    : {
        title: 'How to get in touch with me',
        p1: 'Yes, reach out. Seriously, please do.',
        p2: 'LinkedIn is the right spot for most things - engineering questions, AI nerdery, something you read here, or just wanting to say hi. I actually reply.',
        p3: 'GitHub works if it\'s about code or something you found here. Instagram and Spotify are just proof I have a personality outside of work. DMs there are a long shot.',
      };

const labels = getUiLabels(lang);
---

<IndexLayout
  title={`${strings.title} - ${themeConfig.site.name}`}
  description={strings.title}
  lang={htmlLang}
  headerTitle={strings.title}
>
  <main class="contact">
    <h1 class="sr-only">{strings.title}</h1>
    <BackButton />
    <div class="contact-intro">
      <p>{strings.p1}</p>
      <p>{strings.p2}</p>
      <p>{strings.p3}</p>
    </div>
    <SocialGrid
      links={[
        {
          href: 'https://www.linkedin.com/in/sterlinghamilton/',
          label: 'LinkedIn',
          icon: 'linkedin',
        },
        {
          href: 'https://github.com/grok',
          label: 'GitHub',
          icon: 'github',
        },
        {
          href: 'https://www.instagram.com/sterhamke/',
          label: 'Instagram',
          icon: 'instagram',
        },
        {
          href: 'https://open.spotify.com/user/sterlinghamilton',
          label: 'Spotify',
          icon: 'spotify',
        },
        {
          href: '/resume.pdf',
          label: labels.resume,
          icon: 'resume',
        },
      ]}
    />
  </main>
</IndexLayout>

<style>
  .contact {
    margin-top: 2rem;
  }

  .contact-intro {
    margin-bottom: 1.5rem;
  }

  .contact-intro p {
    margin-bottom: 0.6rem;
    line-height: 1.6;
  }

  .contact-intro p:last-child {
    margin-bottom: 0;
  }
</style>
