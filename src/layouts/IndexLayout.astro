---
import '@/styles/global.css';
import BaseHead from '@/components/layout/BaseHead.astro';
import Footer from '@/components/layout/Footer.astro';
import Header from '@/components/layout/Header.astro';
import GradientMask from '@/components/ui/GradientMask.astro';
import { themeConfig } from '@/config';
import BaseLayout from '@/layouts/BaseLayout.astro';

const { title, description, lang, headerTitle } = Astro.props as {
  title?: string;
  description?: string;
  lang?: string;
  headerTitle?: string;
};
---

<BaseLayout title={title} description={description} type="page" lang={lang}>
  <BaseHead title={title} description={description} slot="head" />
  <div class="page-content">
    <GradientMask />
    <div>
      <Header lang={lang} title={headerTitle} />
    </div>
    <main>
      <slot />
    </main>
    {
      themeConfig.general.footer && (
        <div>
          <Footer />
        </div>
      )
    }
  </div>
</BaseLayout>

<style is:global>
  .page-content {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .page-content main {
    flex: 1;
  }
</style>
