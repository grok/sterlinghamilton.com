---
import '@/styles/global.css';
import BaseHead from '@/components/layout/BaseHead.astro';
import Footer from '@/components/layout/Footer.astro';
import BackButton from '@/components/ui/BackButton.astro';
import GitHubCard from '@/components/ui/GitHubCard.astro';
import GradientMask from '@/components/ui/GradientMask.astro';
import ImageOptimizer from '@/components/ui/ImageOptimizer.astro';
import ImageViewer from '@/components/ui/ImageViewer.astro';
import ThemeToggle from '@/components/ui/ThemeToggle.astro';
import LanguageToggle from '@/components/ui/LanguageToggle.astro';
import ContactIconLink from '@/components/ui/ContactIconLink.astro';
import LinkCard from '@/components/ui/LinkCard.astro';
import NeoDBCard from '@/components/ui/NeoDBCard.astro';
import TableOfContents from '@/components/ui/TableOfContents.astro';
import XPOST from '@/components/ui/XPOST.astro';
import HeadingAnchorCopy from '@/components/widgets/HeadingAnchorCopy.astro';
import FootnoteScroll from '@/components/widgets/FootnoteScroll.astro';
import FormattedDate from '@/components/widgets/FormattedDate.astro';
import MermaidEnhancements from '@/components/widgets/MermaidEnhancements.astro';
import { themeConfig } from '@/config';
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { PostLayoutProps } from '@/types';
import { getUiLabels } from '@/utils/i18n';

const { title, pubDate, readingTime, toc, lang, translations } = Astro.props as PostLayoutProps;

const postSlug = Astro.url.pathname.split('/').filter(Boolean).pop() || '';
const ogImage = `/open-graph/${postSlug}.png`;
const localeCode = translations?.find((t) => t.active)?.code || themeConfig.site.defaultLocale;
const ui = getUiLabels(localeCode);
const contactHref = `/${localeCode}/contact/`;
---

<BaseLayout
  title={`${title} · ${themeConfig.site.name}`}
  description={themeConfig.site.description}
  type="post"
  lang={lang}
>
  <BaseHead
    title={`${title} · ${themeConfig.site.name}`}
    description={themeConfig.site.description}
    ogImage={ogImage}
    slot="head"
  />
  <div class="post-container">
    <main>
      <div class="prose">
        <GradientMask />
        <BackButton />
        {themeConfig.post.toc && <TableOfContents toc={toc} />}
        <div class="title">
          <div class="post-topbar">
            <h1 class="wordmark-title post-title">{title}</h1>
            <div class="post-controls icon-controls">
              <ContactIconLink href={contactHref} label={ui.contact} />
              <ThemeToggle />
              <LanguageToggle translations={translations} />
            </div>
          </div>
          <div class="date">
            <FormattedDate date={pubDate} context="post" />
            {
              themeConfig.post.readingTime && readingTime && (
                <span class="reading-time">
                  <span class="separator">·</span>
                  {readingTime.text}
                </span>
              )
            }
          </div>
        </div>
        <article class="content">
          <slot />
        </article>
      </div>
    </main>
    <ImageOptimizer />
    <FootnoteScroll />
    <GitHubCard />
    <XPOST />
    <NeoDBCard />
    {themeConfig.post.imageViewer && <ImageViewer />}
    {themeConfig.post.linkCard && <LinkCard />}
    {themeConfig.general.footer && <Footer />}

    <MermaidEnhancements />
    <HeadingAnchorCopy />
  </div>
</BaseLayout>

<style>
  /*
    CSS ownership note:
    - Keep *layout/structure* styles for this template here (containers, flex, spacing of chrome).
    - Keep *content/typography* styles in `src/styles/post.css` under the `.prose` hook
      (headings, paragraphs, lists, code blocks, etc.), since `.prose` is reused outside posts.
  */
  .post-container {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .post-container main {
    flex: 1;
  }

  .post-topbar {
    display: flex;
    align-items: center; /* vertically center icons to title */
    justify-content: space-between;
    gap: 1rem;
  }

  .post-title {
    margin: 0;
  }

  .post-controls {
    display: flex;
    align-items: center;
  }
</style>
